# ─────────────────────────────────────────────────────────────────────────────
# tiktok-ads-mcp-server configuration
# TIKTOK_ACCESS_TOKEN and TIKTOK_APP_ID are required. The rest is optional.
# ─────────────────────────────────────────────────────────────────────────────

# Long-lived access token from your TikTok for Business developer app.
# See the "Getting a token" section of the README.
TIKTOK_ACCESS_TOKEN=

# The App ID of that same developer app. TikTok ties the token to the app,
# so both are needed.
TIKTOK_APP_ID=

# Optional. Only needed if you call endpoints that require app authentication.
# TIKTOK_APP_SECRET=

# Optional. Saves passing advertiserId on every call.
# TIKTOK_ADVERTISER_ID=

# Optional. Business Center ID, for Business Center scoped reads.
# TIKTOK_BC_ID=

# Write tools are OFF by default. Set to 1 to register the 5 write tools.
# They need campaign management scopes, not just read scopes.
# Every write still previews first and applies only on a second call
# with confirm: true.
# TIKTOK_ENABLE_WRITES=1

# debug | info | warn | error
# LOG_LEVEL=info
